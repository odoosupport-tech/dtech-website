{
  "outputDirectory": ".",
  "buildCommand": "echo 'static prebuilt site: CSS/JS committed, nothing to build'",
  "functions": {
    "api/send-whitepaper.js": {
      "includeFiles": "assets/case-studies/**/*.pdf",
      "maxDuration": 15
    },
    "api/contact.js": {
      "maxDuration": 15
    },
    "api/apply.js": {
      "includeFiles": "data/jobs.json",
      "maxDuration": 20
    },
    "api/jobs.js": {
      "includeFiles": "data/jobs.json"
    },
    "api/admin/data.js": {
      "includeFiles": "data/*.json",
      "maxDuration": 15
    },
    "api/admin/update.js": {
      "maxDuration": 15
    },
    "api/admin/console.js": {
      "includeFiles": "api/admin/_console-app.js"
    }
  },
  "redirects": [
    {
      "source": "/products.html",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/solutions.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!(?:hp|dell|motorola)\\.html).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://i.ytimg.com; connect-src 'self'; frame-src https://prezi.com https://*.prezi.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(hp|dell|motorola)\\.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://syndication.inc.hp.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://i.ytimg.com; connect-src 'self'; frame-src https://prezi.com https://*.prezi.com https://syndication.inc.hp.com https://sites.ziftsolutions.com https://www.motorolasolutions.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/api/((?!jobs$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/portal.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
