{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "echo 'static prebuilt site: CSS/JS committed, nothing to build'",
  "functions": {
    "api/send-whitepaper.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 30
    },
    "api/apply.js": {
      "includeFiles": "data/jobs.json",
      "maxDuration": 30
    },
    "api/jobs.js": {
      "includeFiles": "data/jobs.json"
    },
    "api/admin/data.js": {
      "includeFiles": "data/*.json",
      "maxDuration": 30
    },
    "api/admin/update.js": {
      "maxDuration": 30
    },
    "api/admin/console.js": {
      "includeFiles": "api/admin/_console-app.js",
      "maxDuration": 30
    },
    "api/admin/auth.js": {
      "maxDuration": 30
    },
    "api/admin/mail-check.js": {
      "maxDuration": 30
    },
    "api/content.js": {
      "includeFiles": "data/*.json"
    },
    "api/detail.js": {
      "includeFiles": "data/*.json"
    }
  },
  "redirects": [
    {
      "source": "/solutions.html",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/api/(.+)\\.(js|json)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/(vercel\\.json|README\\.md|purgecss\\.config\\.js|\\.gitignore)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/data/(.*)",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.png",
      "permanent": true
    },
    {
      "source": "/products.html",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/admin-dtech/",
      "destination": "/admin-dtech",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us-2",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/compliance",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/forklift-ai-solution",
      "destination": "/forklift-ai",
      "permanent": true
    },
    {
      "source": "/engineering-services",
      "destination": "/jiva-engineering-services",
      "permanent": true
    },
    {
      "source": "/heavy-lifting",
      "destination": "/jiva-heavy-lifting",
      "permanent": true
    },
    {
      "source": "/special-purpose-automation",
      "destination": "/jiva-special-purpose-machines",
      "permanent": true
    },
    {
      "source": "/system-integration",
      "destination": "/jiva-system-integration",
      "permanent": true
    },
    {
      "source": "/turnkey-solutions",
      "destination": "/jiva-turnkey-solutions",
      "permanent": true
    },
    {
      "source": "/dtech-intro",
      "destination": "/presentation",
      "permanent": true
    },
    {
      "source": "/showcase",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/career",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/jobs/:path*",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/contactus",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/appointment",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/aboutus",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/case-studies",
      "permanent": false
    },
    {
      "source": "/web/:path*",
      "destination": "https://d-tech-live-database.odoo.com/web/:path*",
      "permanent": false
    },
    {
      "source": "/odoo/:path*",
      "destination": "https://d-tech-live-database.odoo.com/odoo/:path*",
      "permanent": false
    },
    {
      "source": "/my/:path*",
      "destination": "https://d-tech-live-database.odoo.com/my/:path*",
      "permanent": false
    },
    {
      "source": "/(about-us|why-dtech|history-and-milestone|vendors|software)(\\.html)?",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/(contact-us|tally-offers)(\\.html)?",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/(privacy|privacy&policy)(\\.html)?",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/(cctv-sol|cctv-solution)(\\.html)?",
      "destination": "/ai-video-analytics",
      "permanent": true
    },
    {
      "source": "/(automatin-solution|automation-solution)(\\.html)?",
      "destination": "/jiva",
      "permanent": true
    },
    {
      "source": "/(printing-solution)(\\.html)?",
      "destination": "/hp",
      "permanent": true
    },
    {
      "source": "/(desktop-laptop-server-storage|dell-offer)(\\.html)?",
      "destination": "/dell",
      "permanent": true
    },
    {
      "source": "/(product)(\\.html)?",
      "destination": "/tfms",
      "permanent": true
    },
    {
      "source": "/(customers|services|access-control|access-control-system|fire-sol|fire-solution|data-security|network-server-rack|optic-fiber|raised-floor|wireless-solution|ups-solution|public-address-solution|telecom-epabx|av-boardroom-solution|video-conference-solution)(\\.html)?",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/(Index|led-display|pdf)(\\.html)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-dtech",
      "destination": "/portal"
    },
    {
      "source": "/case-studies/:id",
      "destination": "/api/detail?type=case&id=:id"
    },
    {
      "source": "/careers/:id",
      "destination": "/api/detail?type=job&id=:id"
    },
    {
      "source": "/sitemap-details.xml",
      "destination": "/api/detail?type=sitemap"
    }
  ],
  "headers": [
    {
      "source": "/assets/case-studies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
