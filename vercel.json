{
  "outputDirectory": ".",
  "buildCommand": "echo 'static prebuilt site: CSS/JS committed, nothing to build'",
  "functions": {
    "api/send-whitepaper.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 30
    },
    "api/apply.js": {
      "includeFiles": "data/jobs.json",
      "maxDuration": 30
    },
    "api/jobs.js": {
      "includeFiles": "data/jobs.json"
    },
    "api/admin/data.js": {
      "includeFiles": "data/*.json",
      "maxDuration": 30
    },
    "api/admin/update.js": {
      "maxDuration": 30
    },
    "api/admin/console.js": {
      "includeFiles": "api/admin/_console-app.js",
      "maxDuration": 30
    },
    "api/admin/auth.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.png",
      "permanent": true
    },
    {
      "source": "/products.html",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/admin-dtech/",
      "destination": "/admin-dtech",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us-2",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/compliance",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/ai-supervisor",
      "destination": "/ai-supervisor.html",
      "permanent": true
    },
    {
      "source": "/ai-video-analytics",
      "destination": "/ai-video-analytics.html",
      "permanent": true
    },
    {
      "source": "/cafeteria",
      "destination": "/cafeteria.html",
      "permanent": true
    },
    {
      "source": "/kiosk",
      "destination": "/kiosk.html",
      "permanent": true
    },
    {
      "source": "/tfms",
      "destination": "/tfms.html",
      "permanent": true
    },
    {
      "source": "/forklift-ai-solution",
      "destination": "/forklift-ai.html",
      "permanent": true
    },
    {
      "source": "/jiva",
      "destination": "/jiva.html",
      "permanent": true
    },
    {
      "source": "/engineering-services",
      "destination": "/jiva-engineering-services.html",
      "permanent": true
    },
    {
      "source": "/heavy-lifting",
      "destination": "/jiva-heavy-lifting.html",
      "permanent": true
    },
    {
      "source": "/special-purpose-automation",
      "destination": "/jiva-special-purpose-machines.html",
      "permanent": true
    },
    {
      "source": "/system-integration",
      "destination": "/jiva-system-integration.html",
      "permanent": true
    },
    {
      "source": "/turnkey-solutions",
      "destination": "/jiva-turnkey-solutions.html",
      "permanent": true
    },
    {
      "source": "/dell",
      "destination": "/dell.html",
      "permanent": true
    },
    {
      "source": "/hp",
      "destination": "/hp.html",
      "permanent": true
    },
    {
      "source": "/motorola",
      "destination": "/motorola.html",
      "permanent": true
    },
    {
      "source": "/dtech-intro",
      "destination": "/presentation.html",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/case-studies.html",
      "permanent": true
    },
    {
      "source": "/showcase",
      "destination": "/case-studies.html",
      "permanent": true
    },
    {
      "source": "/career",
      "destination": "/careers.html",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/careers.html",
      "permanent": true
    },
    {
      "source": "/jobs/:path*",
      "destination": "/careers.html",
      "permanent": true
    },
    {
      "source": "/contactus",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/appointment",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/shop",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/solutions.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/terms-of-service.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-dtech",
      "destination": "/portal.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/case-studies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!(?:hp|dell|motorola)\\.html).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://i.ytimg.com; connect-src 'self'; frame-src https://prezi.com https://*.prezi.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(hp|dell|motorola)\\.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://syndication.inc.hp.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://i.ytimg.com; connect-src 'self'; frame-src https://prezi.com https://*.prezi.com https://syndication.inc.hp.com https://sites.ziftsolutions.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/api/((?!jobs$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(portal\\.html|admin-dtech)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
